SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///authkit.db
SESSION_COOKIE_SECURE=false

# Brevo transactional email settings
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_EMAIL=noreply@your-domain.example
MAIL_FROM_NAME=Flask AuthKit
# Create these templates in Brevo and use their numeric IDs.
BREVO_PASSWORD_RESET_TEMPLATE_ID=1
BREVO_EMAIL_VERIFICATION_TEMPLATE_ID=2
BREVO_WELCOME_TEMPLATE_ID=3
